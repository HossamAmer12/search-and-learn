    "version": "0.2.0",
    "configurations": [

        {
            "name": "Launch Test Time Compute",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/test_time_compute.py",
            "args": [
                "--dataset_start=0",
                "--dataset_end=1",
                "--search_batch_size=25",
                "--seed=1",
                "--n=4"
            ],
            "env": {
                "CUDA_VISIBLE_DEVICES": "4,5,6,7"
            },
            "console": "integratedTerminal"
        },
        {
            "name": "Launch Skywork",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/test_time_compute.py",
            "args": [
                "recipes/TinyLlama_v1.1_math_code/dvts.yaml",
                "--dataset_start=0",
                "--dataset_end=10",
                "--search_batch_size=25",
                "--prm_batch_size=1",
                "--seed=1",
                "--n=64",
                "--model_path=/home/m00918254/TTC-checkpoints/tinyllama-math-code-checkpoint-200",
                "--prm_path=Skywork/Skywork-o1-Open-PRM-Qwen-2.5-1.5B",
                "--gpu_memory_utilization=0.45"
            ],
            "env": {
                "CUDA_VISIBLE_DEVICES": "4,5,6,7"
            },
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}